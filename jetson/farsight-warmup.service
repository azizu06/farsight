# Template: jetson/install_service.sh fills @REPO@ and @ENV_FILE@. Started by farsight-warmup.timer.
[Unit]
Description=Farsight post-boot warm-up (re-pin Jetson clocks, one text and one voice /ask)
After=farsight.service farsight-llm.service farsight-whisper.service

[Service]
Type=oneshot
EnvironmentFile=@ENV_FILE@
ExecStart=@REPO@/jetson/warmup.sh
StandardOutput=journal
StandardError=journal

# Template: jetson/install_service.sh fills @USER@, @REPO@, @SRC@ and installs it when whisper-server and the model exist.
[Unit]
Description=Farsight speech to text (whisper.cpp whisper-server, CUDA)
After=network.target
ConditionPathExists=@SRC@/whisper.cpp/build/bin/whisper-server

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment="FARSIGHT_SELECTED_WHISPER_MODEL=@WHISPER_MODEL@"
EnvironmentFile=@ENV_FILE@
ExecStartPre=/usr/bin/test -s "${FARSIGHT_SELECTED_WHISPER_MODEL}"
ExecStart=@SRC@/whisper.cpp/build/bin/whisper-server -m "${FARSIGHT_SELECTED_WHISPER_MODEL}" --host 127.0.0.1 --port 8091 --threads 2
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Template: jetson/install_service.sh fills @USER@ and @REPO@ and installs it.
[Unit]
Description=Farsight rover server (camera, detector, rover control, video)
Wants=network-online.target
After=network-online.target tailscaled.service farsight-llm.service farsight-whisper.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
SupplementaryGroups=dialout video
WorkingDirectory=@REPO@
EnvironmentFile=/etc/farsight.env
# jetson.launch waits up to FARSIGHT_WAIT_SECONDS for the camera and Uno device nodes, then execs python -m jetson.server.
ExecStart=@REPO@/jetson/.venv/bin/python -m jetson.launch
Restart=on-failure
RestartSec=2
# Journald only: journalctl -u farsight -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

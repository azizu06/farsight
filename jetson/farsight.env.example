# Template for /etc/farsight.env (jetson/install_service.sh renders it once via jetson/envgen.py and never overwrites
# an existing file). Read by jetson/farsight.service -> jetson/launch.py. Blank values are skipped and the server
# default applies. Check without starting the server: jetson/.venv/bin/python -m jetson.launch --check --env-file /etc/farsight.env

# Camera: /dev/video path (the unit waits for it) or an index like 0. UVC webcams also expose a metadata node
# (/dev/video1): pick the one `v4l2-ctl --list-devices` lists first under the camera.
FARSIGHT_CAMERA=/dev/video0
# Uno serial. Blank keeps physical motors disabled.
FARSIGHT_SERIAL_PORT=/dev/ttyACM0
# Camera-only bring-up without the Uno: blank the serial port and set this to 1 for a virtual rover (never both).
FARSIGHT_SIMULATE_ROVER=
# Ultrasonic proximity stop (range < 25 cm or stale range blocks forward drive). Blank or 1 = on (default).
# 0 = off, an explicit opt-in for navigation runs that steer around obstacles. Lease, deadman, camera,
# disconnect and the Uno 300 ms watchdog always stop. The Uno has a matching compile-time opt-out.
FARSIGHT_PROXIMITY_STOP=
# 1 = opt in to ROS 2 Nav2 navigation (jetson/ros2-install.sh, farsight-nav.service, docs/navigation.md).
# Blank keeps today's reactive Explore/Seek. Calibrate speed/turn on the real chassis before relying on it.
FARSIGHT_NAV2=
FARSIGHT_NAV_SPEED_MPS=
FARSIGHT_NAV_TURN_RADPS=
# Caps on Nav2 commands, normalized 0..1 (defaults 0.7 forward, 0.8 turn).
FARSIGHT_NAV_MAX_V=
FARSIGHT_NAV_MAX_W=
FARSIGHT_NAV_CAMERA_HEIGHT=
# Detector: pose (YOLO11-pose; .engine = TensorRT, .onnx = CPU), hog (bundled CPU), or none.
# A COCO YOLO model path with hog overrides hog; a pose model needs FARSIGHT_DETECTOR=pose.
FARSIGHT_DETECTOR=pose
FARSIGHT_DETECTOR_MODEL=/home/farsight/farsight/models/yolo11n-pose.engine
# Extra UltraFace pass for the rescue drill (models/version-RFB-320.onnx); CPU only.
FARSIGHT_FACE_MODEL=
FARSIGHT_MISSION_DIR=/var/lib/farsight/missions
# 1 = also record JPEG, detections and control into the mission dir (replay later with python -m jetson.server --replay DIR).
FARSIGHT_RECORD=
# Camera-only 3D scan (docs/scan.md): metric depth ONNX or engine, then the camera geometry. Blank = no live scan.
FARSIGHT_DEPTH_MODEL=
# 1 only with a physical camera pan mount; otherwise the scan turns the rover (approximate).
FARSIGHT_SCAN_PAN=
FARSIGHT_SCAN_FOV=
# Four numbers "FX FY CX CY" calibrated for the transmitted 640x480 grid; overrides FARSIGHT_SCAN_FOV.
FARSIGHT_SCAN_INTRINSICS=
FARSIGHT_SCAN_TURN_DPS=
# HTTPS for the Mac relay and the Quest; both or neither. jetson/make_cert.sh writes /etc/farsight/tls/*.pem.
FARSIGHT_SSL_CERTFILE=
FARSIGHT_SSL_KEYFILE=
FARSIGHT_HOST=0.0.0.0
FARSIGHT_PORT=8443
# CPU H.264 over /ws/video (1 = on), and its frame rate / bit/s. Blank = server defaults (10 fps, 500000).
FARSIGHT_H264=0
FARSIGHT_VIDEO_FPS=
FARSIGHT_VIDEO_BITRATE=
# Optional aggregate bulk egress cap in decimal Mbps; control and permits stay unpaced.
# 0 disables pacing. Choose a profile only after measuring the actual cellular link.
FARSIGHT_BULK_LIMIT_MBPS=0
# Motor PWM ceiling and measured wheel-start floor (1..255).
FARSIGHT_MAX_PWM=100
FARSIGHT_MIN_PWM=0
# Seconds to wait for the device nodes above before starting degraded.
FARSIGHT_WAIT_SECONDS=30
# Local assistant (POST /ask). Blank answers from the observation summary only. The installer fills these when it
# installs farsight-llm.service (matching SmolVLM or Qwen pair) and farsight-whisper.service (whisper-server).
FARSIGHT_ASSISTANT_URL=
FARSIGHT_WHISPER_URL=
# Optional explicit unit-model overrides. Blank lets the installer choose complete prepared artifacts.
# Re-run install_service.sh after changing these: selected paths are rendered into the native unit defaults.
FARSIGHT_LLM_MODEL=
FARSIGHT_LLM_MMPROJ=
FARSIGHT_WHISPER_SERVER_MODEL=
# Fallback per-question transcription with whisper-cli when no whisper-server runs.
FARSIGHT_WHISPER_BIN=
FARSIGHT_WHISPER_MODEL=
# Piper voice: prepared models/en_US-lessac-low.onnx, or the supported models/piper medium layout.
FARSIGHT_PIPER_BIN=
FARSIGHT_PIPER_MODEL=
# Spanish voice for survivor phrases (POST /speak).
FARSIGHT_PIPER_MODEL_ES=
FARSIGHT_TTS_DIR=/var/lib/farsight/tts
# Minimum seconds between SBAR triage model calls.
FARSIGHT_TRIAGE_INTERVAL=
# Rover speaker (USB speaker; the Orin Nano has no headphone jack): auto, "aplay -q", "paplay", or none.
FARSIGHT_SPEAKER_CMD=auto

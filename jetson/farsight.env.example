# Copy to /etc/farsight.env (jetson/install_service.sh does this once). Read by jetson/farsight.service.
# Unset or blank values are skipped and the server default applies.

# Camera: /dev/video path (the unit waits for it) or an index like 0.
FARSIGHT_CAMERA=/dev/video0
# Uno serial. Omit to keep physical motors disabled.
FARSIGHT_SERIAL_PORT=/dev/ttyACM0
# Detector: pose (YOLO11-pose; .engine = TensorRT, .onnx = CPU), hog (bundled CPU), or none.
# A COCO YOLO model path with hog overrides hog; a pose model needs FARSIGHT_DETECTOR=pose.
FARSIGHT_DETECTOR=pose
FARSIGHT_DETECTOR_MODEL=/home/farsight/farsight/models/yolo11n-pose.engine
FARSIGHT_MISSION_DIR=/var/lib/farsight/missions
# HTTPS for the Quest and the relay; both or neither.
FARSIGHT_SSL_CERTFILE=/etc/farsight/tls/cert.pem
FARSIGHT_SSL_KEYFILE=/etc/farsight/tls/key.pem
FARSIGHT_HOST=0.0.0.0
FARSIGHT_PORT=8443
# CPU H.264 over /ws/video (1 = on).
FARSIGHT_H264=0
# Motor PWM ceiling and measured wheel-start floor (1..255).
FARSIGHT_MAX_PWM=100
FARSIGHT_MIN_PWM=0
# Seconds to wait for the device nodes above before starting degraded.
FARSIGHT_WAIT_SECONDS=30
# Local assistant (POST /ask). Leave blank to answer from the observation summary only.
# llama-server --mmproj origin (Qwen2.5-VL-3B Q4 default), and whisper-server origin (model stays loaded).
FARSIGHT_ASSISTANT_URL=
FARSIGHT_WHISPER_URL=
# Fallback per-question transcription with whisper-cli when no whisper-server runs.
FARSIGHT_WHISPER_BIN=
FARSIGHT_WHISPER_MODEL=
# Piper (pip install piper-tts) and a downloaded .onnx voice; without them the Quest uses speechSynthesis.
FARSIGHT_PIPER_BIN=
FARSIGHT_PIPER_MODEL=
FARSIGHT_TTS_DIR=/var/lib/farsight/tts

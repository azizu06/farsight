{
  "name": "farsight-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs && npm run test:unit",
    "test:browser": "playwright test",
    "test:unit": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}

{
  "name": "farsight-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/xr-input.browser.mjs && node tests/health-page.browser.mjs && node tests/splat-input.browser.mjs",
    "test:judge": "node tests/judge-flow.e2e.mjs",
    "perf": "node tests/frame-budget.browser.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/three": "^0.180.0",
    "iwer": "2.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}

# Same-origin proxy for desktop development; production Jetson serves quest/dist.
FARSIGHT_JETSON_ORIGIN=https://127.0.0.1:8443
# Explicitly allow only your known local Jetson/mock self-signed certificate.
# FARSIGHT_ALLOW_SELF_SIGNED=1
# Browser-facing certificate/key issued for your actual hostname/IP:
# FARSIGHT_TLS_CERT=/absolute/path/cert.pem
# FARSIGHT_TLS_KEY=/absolute/path/key.pem

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>farsight_nvblox</name>
  <version>0.1.0</version>
  <description>Optional GPU costmap source for Farsight navigation: Isaac ROS nvblox config, launch, Nav2 layer wiring and depth/synthetic helpers.</description>
  <maintainer email="azizu06@users.noreply.github.com">azizu06</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Not declared: ros-jazzy-nvblox-ros, -nvblox-nav2 and -nvblox-msgs come from NVIDIA's
       Isaac ROS apt repo (jetson/nvblox-install.sh), which rosdep cannot resolve. -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

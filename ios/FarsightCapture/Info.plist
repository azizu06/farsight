<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>Farsight Capture</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSCameraUsageDescription</key><string>Stream the rover camera and measured LiDAR depth to your local Jetson for the Farsight demo.</string>
    <key>NSMicrophoneUsageDescription</key><string>Send live two-way intercom audio between the rover iPhone and Quest when Talk is enabled in the headset.</string>
    <key>NSLocalNetworkUsageDescription</key><string>Connect the rover camera and phone relay to the Jetson over its local USB network.</string>
    <key>NSAppTransportSecurity</key><dict>
        <key>NSAllowsArbitraryLoads</key><true/>
        <key>NSAllowsLocalNetworking</key><true/>
    </dict>
    <key>UIApplicationSceneManifest</key><dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <key>UILaunchScreen</key><dict/>
    <key>UIRequiresFullScreen</key><true/>
    <key>UISupportedInterfaceOrientations</key><array>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict></plist>
